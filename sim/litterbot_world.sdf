<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="litterbot_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0.5 -0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="target_coke_can">
      <static>true</static>
      <pose>3 0 0.19 0 0 0</pose>
      <link name="link">
        <collision name="body_collision">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.075</radius>
              <length>0.27</length>
            </cylinder>
          </geometry>
        </collision>
        <collision name="neck_collision">
          <pose>0 0 0.135 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.032</radius>
              <length>0.12</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="bottle_body">
          <pose>0 0 -0.035 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.075</radius>
              <length>0.27</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.06 0.035 0.02 1</ambient>
            <diffuse>0.10 0.06 0.035 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <visual name="red_label_front">
          <pose>0.001 0 0.0 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.077</radius>
              <length>0.075</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <visual name="white_label_band">
          <pose>0.002 0 0.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.155 0.012 0.022</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <visual name="shoulder">
          <pose>0 0 0.105 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.074</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.06 0.035 0.02 1</ambient>
            <diffuse>0.10 0.06 0.035 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <visual name="neck">
          <pose>0 0 0.145 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.032</radius>
              <length>0.13</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.055 0.032 0.018 1</ambient>
            <diffuse>0.09 0.05 0.03 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <visual name="red_cap">
          <pose>0 0 0.225 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.036</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.02 0.02 1</ambient>
            <diffuse>0.9 0.02 0.02 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>




  </world>
</sdf>
